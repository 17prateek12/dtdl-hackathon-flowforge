OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Set to true to run without API keys (deterministic local agents)
MOCK_AGENTS=true

# Shared at monorepo root. Next.js (frontend/next.config.ts) rewrites /api/* here.
# Use 8001 if another service already occupies port 8000.
LOOPFORGE_API_ORIGIN=http://127.0.0.1:8001
